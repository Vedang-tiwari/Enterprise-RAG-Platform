APP_ENV=development
APP_NAME=Enterprise-RAG-Platform
DEBUG=True
SECRET_KEY=dev_secret_jwt_key_change_in_production_min_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database - Defaults to SQLite for immediate local plug-and-play, or PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./enterprise_rag.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_rag

# Redis Cache & Rate Limiting (optional in dev, fallback to in-memory)
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Store (optional in dev, fallback to built-in semantic memory store)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# RabbitMQ / Celery (optional in dev, fallback to in-memory background worker)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Storage - Local disk fallback or S3/MinIO
STORAGE_TYPE=local
STORAGE_DIR=./storage_data
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=enterprise-documents

# LLM & Embeddings Provider
LLM_PROVIDER=mock
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# GROQ_API_KEY=...
# ANTHROPIC_API_KEY=...

EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# Rate Limits
RATE_LIMIT_PER_MINUTE=100
MAX_UPLOAD_SIZE_MB=50
